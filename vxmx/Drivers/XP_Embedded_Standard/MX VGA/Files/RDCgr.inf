; RDCGR.inf
; Installation inf for the M2010 Graphics Adapter.
;

[Version]
Signature="$Windows NT$"
Provider=%Provider%
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
DriverVer=06/15/2010,6.14.10.0010
;CatalogFile=rdcgr.cat

[DestinationDirs]
DefaultDestDir  = 11
RDCGR.Miniport  = 12
RDCGR.Display   = 11

;
; Driver information
;
[Manufacturer]
%Mfg% = RDC.Mfg

[RDC.Mfg]
%Vendor.RDCM2010.Device1%	= RDC , PCI\VEN_17F3&DEV_2010

;
; General installation section
;
[RDC]
CopyFiles=RDCGR.Miniport, RDCGR.Display , RDCGR.Setmode , RDCGR.Utility
AddReg=RDCGR.AddReg

;
; File sections
;
[RDCGR.Miniport]
rdcgm.sys

[RDCGR.Display]
rdcgd.dll

[RDCGR.Setmode]
Setmode32.exe

[RDCGR.Utility]
Utility.exe
EventHook.dll
DisplayPage.dll
en_US.dll
zh_CN.dll
zh_TW.dll
banner.bmp

;
; Service Installation
;
[RDC.Services]
AddService = RDCGraphics, 0x00000002, RDC_Service_Inst, RDC_EventLog_Inst

[RDC_Service_Inst]
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 1                  ; SERVICE_SYSTEM_START
ErrorControl   = 0                  ; SERVICE_ERROR_IGNORE
LoadOrderGroup = Video
ServiceBinary  = %12%\rdcgm.sys

[RDC_EventLog_Inst]
AddReg = RDC_EventLog_AddReg

[RDC_EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\drivers\rdcgm.sys"
HKR,,TypesSupported,0x00010001,7

;
; Software Installation
;
[RDC.SoftwareSettings]
AddReg = RDC_SoftwareDeviceSettings

[RDC_SoftwareDeviceSettings]
HKR,, InstalledDisplayDrivers,           %REG_MULTI_SZ%, RDCGD
HKR,, VgaCompatible,                     %REG_DWORD%,    0
HKR,, CBios.Enable,                      %REG_DWORD%,    0x0
; all 2D
HKR,, 2D.ulEngCaps,                      %REG_DWORD%,    0xCDFFFF
HKR,, VGA.ulModeBWChkDisable,            %REG_DWORD%,    0x0
HKR,, HardwareInformation.FpgaChip,      %REG_DWORD%,    0x0
HKR,, I2C_CRT_PORT,                      %REG_BINARY%,   0xB7
HKR,, I2C_DVP0_PORT,                     %REG_BINARY%,   0xB5
HKR,, I2C_DVP1_PORT,                     %REG_BINARY%,   0xB5
HKR,, I2C_7114_SLAVE_ADDRESS,            %REG_BINARY%,   0x42
HKR,, I2C_CX843X_SLAVE_ADDRESS,          %REG_BINARY%,   0x88
HKR,, CRT_SENSE,            		 %REG_BINARY%,   0x1

[RDCGR.AddReg]
;Add registry to do setmode
HKLM,Software\MicroSoft\Windows\CurrentVersion\Run,Setmode,,"Setmode32.exe"
HKLM,Software\MicroSoft\Windows\CurrentVersion\Run,Utility,,"Utility.exe"

;
; Source file information
;
[SourceDisksNames]
1 = %DiskId%,,,""

[SourceDisksFiles]
rdcgm.sys = 1
rdcgd.dll = 1
Setmode32.exe = 1
Utility.exe = 1
EventHook.dll = 1
DisplayPage.dll = 1
en_US.dll = 1
zh_CN.dll = 1
zh_TW.dll = 1
banner.bmp = 1


[RDC.GeneralConfigData]
MaximumDeviceMemoryConfiguration=512
MaximumNumberOfDevices=4

[Strings]
;
; Non-Localizable Strings
;
REG_SZ         = 0x00000000
REG_MULTI_SZ   = 0x00010000
REG_EXPAND_SZ  = 0x00020000
REG_BINARY     = 0x00000001
REG_DWORD      = 0x00010001
SERVICEROOT    = "System\CurrentControlSet\Services"

;
; Localizable Strings
;
DiskId     = "Installation Disk"
Provider   = "GFX"
Mfg        = "GFX"
Vendor.RDCM2010.Device1  = "D1010"
